# mg5_ttbar_13TeV_lo.mg5
# LO QCD ttbar production at 13 TeV, pp -> t t~ (no [QCD] NLO tag)
# Fixed-order, parton-level study: top quarks are left STABLE/undecayed
# (no decay chain syntax, no MadSpin, no Pythia8 shower, no Delphes).
# Executed remotely via Magnus blueprints (madgraph-compile + madgraph-launch);
# this file records the equivalent standalone MG5 command sequence for
# reproducibility.

import model sm
generate p p > t t~
output events/lo/pp_ttbar_13TeV_lo

launch events/lo/pp_ttbar_13TeV_lo
done
set nevents 100000
set ebeam1 6500
set ebeam2 6500
set param_card MASS 6 172.5
set pdlabel lhapdf
set lhaid 247000
set dynamical_scale_choice 3
set fixed_ren_scale False
set fixed_fac_scale False
set use_syst True
set systematics_program systematics
set systematics_arguments ['--mur=0.5,1,2', '--muf=0.5,1,2']
done
