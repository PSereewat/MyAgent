\# MadGraph5_aMC@NLO script: pp > ttbar @ 13 TeV, NLO QCD
\# Fixed-order, parton level (top quarks stable, no shower, no Delphes)
\# Model: loop_sm (pipeline built-in NLO-capable SM)
\# Executed via Magnus blueprints madgraph-compile + madgraph-launch;
\# this .mg5 file documents the equivalent local-fallback command sequence.

import model loop_sm
generate p p > t t~ [QCD]
output events/nlo/pp_ttbar_13TeV_nlo
launch events/nlo/pp_ttbar_13TeV_nlo
done
set nevents 100000
set ebeam1 6500
set ebeam2 6500
set pdlabel lhapdf
set lhaid 244800
set dynamical_scale_choice 3
set fixed_ren_scale False
set fixed_fac_scale False
set req_acc_FO -1
set param_card MASS 6 172.5
set reweight_scale True
set rw_rscale 1.0, 2.0, 0.5
set rw_fscale 1.0, 2.0, 0.5
set store_rwgt_info True
done
